# ───────── Core ─────────
NODE_ENV=development
PORT=4000
APP_TIMEZONE=Africa/Cairo
FRONTEND_URL=http://localhost:5173        # comma-separated list allowed (CORS)
BACKEND_URL=http://localhost:4000

# ───────── Database ─────────
DATABASE_URL=postgresql://medix:medix@localhost:5432/medix?schema=public
DB_POOL_MAX=20
DB_LOGGING=false

# ───────── Auth (generate with: openssl rand -base64 48) ─────────
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=change_me_to_another_long_random_string_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
COOKIE_SECURE=false                        # true in production (HTTPS)
COOKIE_DOMAIN=

# ───────── Rate limiting ─────────
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ───────── File storage: local | s3 ─────────
UPLOAD_STORAGE=local
UPLOAD_LOCAL_DIR=./storage
UPLOAD_MAX_MB=10
# S3-compatible (AWS S3, MinIO, Cloudflare R2, DigitalOcean Spaces) — bucket must be PRIVATE
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Cloudinary (adapter slot — see StorageService)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ───────── PDF reports (headless Chromium renders Arabic correctly) ─────────
# Leave empty to auto-detect /usr/bin/chromium(-browser) or google-chrome.
# Ubuntu: sudo apt install chromium-browser   |   Alpine/Docker: apk add chromium (already in the Dockerfile)
CHROMIUM_PATH=

# ───────── Email (leave SMTP_HOST empty to log emails in development) ─────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Medix <no-reply@example.com>"

# ───────── WhatsApp: link (wa.me deep links) | cloud_api ─────────
WHATSAPP_PROVIDER=link
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ───────── Payments (Phase 7 — gateway adapters) ─────────
# sandbox = built-in test checkout (card 4242 4242 4242 4242 succeeds, 4000 0000 0000 0002 is declined)
# paymob  = Paymob Accept (Egypt): set the keys below and point the dashboard callbacks to
#           POST {BACKEND_URL}/api/payments/paymob/callback  and  GET {BACKEND_URL}/api/payments/paymob/return
# none    = cash / transfer only (default in production until a gateway is configured)
PAYMENT_GATEWAY=sandbox
PAYMENT_SANDBOX_SECRET=
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# ───────── API docs ─────────
SWAGGER_ENABLED=false                      # Swagger is always on outside production

# ───────── Seed (first super admin) ─────────
SEED_ADMIN_NAME=مدير النظام
SEED_ADMIN_PHONE=+201000000001
SEED_ADMIN_EMAIL=admin@medix.local
SEED_ADMIN_PASSWORD=change-me-strong-password

# ── Security & performance (Phase 8) ──
# Encrypts two-step verification secrets at rest (default: JWT_REFRESH_SECRET). 32+ random chars.
ENCRYPTION_KEY=
# Log requests / SQL queries slower than these (ms); counted on the System health page.
SLOW_REQUEST_MS=1000
SLOW_QUERY_MS=500

